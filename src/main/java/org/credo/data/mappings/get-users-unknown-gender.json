{
  "request": {
    "method": "GET",
    "urlPath": "/users",
    "queryParameters": {
      "gender": {
        "matches": "^(?!male$|female$).*"
      }
    }
  },
  "response": {
    "status": 422,
    "body": "{ \"error\": \"Unprocessable Entity: Unknown gender\" }",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
